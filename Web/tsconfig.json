{
  "compilerOptions": {
    "target": "ES2020", "module": "ES2020", "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "strict": true,
    "outDir": "dist", "rootDir": "src", "noEmitOnError": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/**/*.ts"]
}
